// O setup.py gera o secrets.h (certificado e chave) e mantém o WiFi que já estiver
// nele. Sem setup: copie para secrets.h e preencha. secrets.h fica fora do git.
#pragma once

#define WIFI_SSID "minha-rede"
#define WIFI_PASS "minha-senha"

// Certificado do thing (emitido pelo AWS IoT a partir de um CSR)
static const char DEVICE_CERT[] = R"PEM(
-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----
)PEM";

// Chave privada gerada localmente (openssl ecparam -name prime256v1 -genkey)
static const char DEVICE_KEY[] = R"PEM(
-----BEGIN EC PRIVATE KEY-----
...
-----END EC PRIVATE KEY-----
)PEM";
