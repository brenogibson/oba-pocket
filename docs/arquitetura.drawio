        <mxCell id="c1" value="Oba Pocket — arquitetura" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#232F3E;spacing=2;" vertex="1" parent="1"><mxGeometry x="50" y="10" width="900" height="36" as="geometry"/></mxCell>
        <mxCell id="c2" value="Placa M5Stack Core2 conectada ao AWS IoT Core, agente no Amazon Bedrock AgentCore, portal web e, opcionalmente, o Claude Code como fonte externa (ponte)." style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#545B64;spacing=2;" vertex="1" parent="1"><mxGeometry x="50" y="46" width="1200" height="20" as="geometry"/></mxCell>
        <mxCell id="c3" value="Máquina do admin — credenciais AWS, instalação e CLI" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.client;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1"><mxGeometry x="50" y="80" width="540" height="160" as="geometry"/></mxCell>
        <mxCell id="c4" value="setup.py — provisiona a conta (idempotente); gera a chave privada + CSR&lt;br&gt;(openssl P-256) da placa e de cada ponte" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c3"><mxGeometry x="14" y="26" width="526" height="28" as="geometry"/></mxCell>
        <mxCell id="c5" value="tools/oba.py — validate · publish · install de pacotes de personagem (Obas);&lt;br&gt;install envia o pacote direto à placa (MQTT) e depois sincroniza o registro no S3" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c3"><mxGeometry x="14" y="56" width="526" height="32" as="geometry"/></mxCell>
        <mxCell id="c6" value="PlatformIO (gravação)&lt;br&gt;tools/monitor.py (serial)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#545B64;fontColor=#232F3E;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="c3"><mxGeometry x="14" y="94" width="160" height="28" as="geometry"/></mxCell>
        <mxCell id="c7" value="src/secrets.h + src/aws_config.h&lt;br&gt;(gerados pelo setup.py; secrets.h em 0600)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;fontColor=#232F3E;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="c3"><mxGeometry x="204" y="94" width="322" height="28" as="geometry"/></mxCell>
