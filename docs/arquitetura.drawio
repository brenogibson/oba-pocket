        <mxCell id="c20" value="Até 4 fontes por Oba. Cada máquina tem&lt;br&gt;1 thing + 1 certificado + tópico ext/&amp;lt;fonte&amp;gt;&lt;br&gt;e usa o mesmo fluxo 5." style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#545B64;spacing=2;" vertex="1" parent="c19"><mxGeometry x="8" y="24" width="238" height="60" as="geometry"/></mxCell>
