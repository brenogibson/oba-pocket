        <mxCell id="c18" value="~/.oba-ponte (0700): certificado, chave e CA em 0600&lt;br&gt;chave gerada pelo setup.py --ponte na máquina do admin; copiada por canal seguro; ponte/install.py → ~/.oba-ponte" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#545B64;spacing=2;" vertex="1" parent="c12"><mxGeometry x="14" y="224" width="256" height="70" as="geometry"/></mxCell>
