        <mxCell id="c165" value="&amp;nbsp;HTTPS&amp;nbsp;" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontStyle=0;fontColor=#232F3E;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e163"><mxGeometry x="0.0920" y="0" width="45" height="16" relative="1" as="geometry"><mxPoint x="-22.50" y="-8.00" as="offset"/></mxGeometry></mxCell>
        <mxCell id="c166" value="Fluxos numerados" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="1345" width="900" height="300" as="geometry"/></mxCell>
        <mxCell id="c167" value="1" style="rounded=1;arcSize=50;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="c166"><mxGeometry x="12" y="26" width="20" height="17" as="geometry"/></mxCell>
        <mxCell id="c168" value="Placa ⇄ IoT Core — MQTT mTLS 8883 (cert. X.509 da placa): publica state (retido, LWT), evt, transcript, reply e ext/…/re; assina cmd e ext/+" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c166"><mxGeometry x="38" y="25" width="858" height="18" as="geometry"/></mxCell>
        <mxCell id="c169" value="2" style="rounded=1;arcSize=50;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="c166"><mxGeometry x="12" y="44.5" width="20" height="17" as="geometry"/></mxCell>
        <mxCell id="c170" value="Placa → provedor de credenciais — HTTPS mTLS no alias de função (role alias); recebe credenciais STS de 1 h da função &amp;lt;p&amp;gt;-transcribe" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c166"><mxGeometry x="38" y="43.5" width="858" height="18" as="geometry"/></mxCell>
        <mxCell id="c171" value="3" style="rounded=1;arcSize=50;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="c166"><mxGeometry x="12" y="63" width="20" height="17" as="geometry"/></mxCell>
        <mxCell id="c172" value="Placa ⇄ Transcribe (&amp;lt;região-tr&amp;gt;) — WebSocket 8443 assinado (SigV4): áudio PCM 16 kHz só com REC ligado; o texto volta pelo mesmo WebSocket" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c166"><mxGeometry x="38" y="62" width="858" height="18" as="geometry"/></mxCell>
        <mxCell id="c173" value="4" style="rounded=1;arcSize=50;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="c166"><mxGeometry x="12" y="81.5" width="20" height="17" as="geometry"/></mxCell>
        <mxCell id="c174" value="Regra &amp;lt;p_&amp;gt;_router → Lambda router (permissão de recurso): DynamoDB, oba.json no S3, agente AgentCore (→ Bedrock) ou HTTP; publica cmd e ui/*" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c166"><mxGeometry x="38" y="80.5" width="858" height="18" as="geometry"/></mxCell>
        <mxCell id="c175" value="5" style="rounded=1;arcSize=50;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="c166"><mxGeometry x="12" y="100" width="20" height="17" as="geometry"/></mxCell>
        <mxCell id="c176" value="Claude Code ⇄ hook.py ⇄ ponte.sock ⇄ daemon → MQTT ext/&amp;lt;fonte&amp;gt; (status, ask, ask.cancel, react), 8883 ou 443; lê ext/&amp;lt;fonte&amp;gt;/re e state" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c166"><mxGeometry x="38" y="99" width="858" height="18" as="geometry"/></mxCell>
        <mxCell id="c177" value="6" style="rounded=1;arcSize=50;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="c166"><mxGeometry x="12" y="118.5" width="20" height="17" as="geometry"/></mxCell>
        <mxCell id="c178" value="Navegador → CloudFront → S3 (site) e /api/* → Lambda portal-api (OAC, SigV4); login OAuth2 no User Pool (código + PKCE)" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c166"><mxGeometry x="38" y="117.5" width="858" height="18" as="geometry"/></mxCell>
        <mxCell id="c179" value="7" style="rounded=1;arcSize=50;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="c166"><mxGeometry x="12" y="137" width="20" height="17" as="geometry"/></mxCell>
        <mxCell id="c180" value="Navegador → Identity Pool → MQTT WSS 443 (só assina e recebe &amp;lt;p&amp;gt;/&amp;lt;dev&amp;gt;/…; ext/ negado); portal-api: GetId + AttachPolicy, publica cmd por HTTPS" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c166"><mxGeometry x="38" y="136" width="858" height="18" as="geometry"/></mxCell>
        <mxCell id="c181" value="8" style="rounded=1;arcSize=50;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="c166"><mxGeometry x="12" y="155.5" width="20" height="17" as="geometry"/></mxCell>
        <mxCell id="c182" value="Instalar Oba: portal-api → installer (assíncrono) → pacote do S3 → cmd oba.install/oba.chunk ⇄ reply (MQTT WSS); progresso em ui/install" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c166"><mxGeometry x="38" y="154.5" width="858" height="18" as="geometry"/></mxCell>
        <mxCell id="c183" value="9" style="rounded=1;arcSize=50;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="c166"><mxGeometry x="12" y="174" width="20" height="17" as="geometry"/></mxCell>
        <mxCell id="c184" value="tools/oba.py → envia o pacote direto à placa (oba.install/oba.chunk, MQTT WSS) e depois sincroniza o registro no S3" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c166"><mxGeometry x="38" y="173" width="858" height="18" as="geometry"/></mxCell>
        <mxCell id="c185" value="10" style="rounded=1;arcSize=50;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="c166"><mxGeometry x="12" y="192.5" width="20" height="17" as="geometry"/></mxCell>
        <mxCell id="c186" value="setup.py → APIs de controle da AWS: provisiona tudo; gera chaves + CSR, src/secrets.h, src/aws_config.h e build/ponte-&amp;lt;nome&amp;gt;/" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c166"><mxGeometry x="38" y="191.5" width="858" height="18" as="geometry"/></mxCell>
        <mxCell id="c187" value="11" style="rounded=1;arcSize=50;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="c166"><mxGeometry x="12" y="211" width="20" height="17" as="geometry"/></mxCell>
        <mxCell id="c188" value="Máquina do admin ⇄ placa — USB serial: gravação 1,5 Mbaud · monitor 921600 (log, prints, instalar Oba)" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c166"><mxGeometry x="38" y="210" width="858" height="18" as="geometry"/></mxCell>
        <mxCell id="c189" value="12" style="rounded=1;arcSize=50;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="c166"><mxGeometry x="12" y="229.5" width="20" height="17" as="geometry"/></mxCell>
        <mxCell id="c190" value="Placa → NTP — UDP 123 (hora certa para TLS e SigV4)" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c166"><mxGeometry x="38" y="228.5" width="858" height="18" as="geometry"/></mxCell>
        <mxCell id="c191" value="13" style="rounded=1;arcSize=50;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="c166"><mxGeometry x="12" y="248" width="20" height="17" as="geometry"/></mxCell>
        <mxCell id="c192" value="AgentCore → servidores MCP externos — HTTPS (opcional)" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c166"><mxGeometry x="38" y="247" width="858" height="18" as="geometry"/></mxCell>
        <mxCell id="c193" value='Cores das setas: &lt;font color="#3F8624"&gt;&lt;b&gt;━ placa&lt;/b&gt;&lt;/font&gt; · &lt;font color="#147EBA"&gt;&lt;b&gt;━ portal&lt;/b&gt;&lt;/font&gt; · &lt;font color="#D86613"&gt;&lt;b&gt;━ ponte (Claude Code)&lt;/b&gt;&lt;/font&gt; · &lt;font color="#545B64"&gt;&lt;b&gt;━ interno na AWS&lt;/b&gt;&lt;/font&gt; · &lt;font color="#7D8998"&gt;&lt;b&gt;╌ admin / opcional&lt;/b&gt;&lt;/font&gt; · seta dupla = ida e volta' style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#545B64;spacing=2;" vertex="1" parent="c166"><mxGeometry x="12" y="272" width="880" height="20" as="geometry"/></mxCell>
        <mxCell id="c194" value="Segurança e menor privilégio" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;strokeColor=#DD344C;fillColor=#FFFFFF;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#C7131F;" vertex="1" parent="1"><mxGeometry x="965" y="1345" width="560" height="300" as="geometry"/></mxCell>
        <mxCell id="c195" value='&lt;ul style="margin:0;padding-left:16px;"&gt;&lt;li style="margin-bottom:5px;"&gt;O microfone só liga pelo botão REC na placa; a nuvem pode desligar, nunca ligar.&lt;/li&gt;&lt;li style="margin-bottom:5px;"&gt;A placa publica só em &amp;lt;p&amp;gt;/&amp;lt;thing&amp;gt;/…; cada fonte externa só no próprio ext/&amp;lt;fonte&amp;gt;.&lt;/li&gt;&lt;li style="margin-bottom:5px;"&gt;O áudio vai direto da placa ao Transcribe (sem intermediário), com credenciais de 1 h.&lt;/li&gt;&lt;li style="margin-bottom:5px;"&gt;Aprovar um pedido da ponte exige toque na placa; comando perigoso: segurar 1,5 s.&lt;/li&gt;&lt;li style="margin-bottom:5px;"&gt;A regra só casa &amp;lt;p&amp;gt;/+/+: ext/… não passa pelo agente, e o portal não lê ext.&lt;/li&gt;&lt;li style="margin-bottom:5px;"&gt;Chaves privadas (placa e pontes) nascem na máquina do admin (setup.py: openssl P-256 + CSR) e nunca vão para a AWS. A da placa vai compilada no firmware (src/secrets.h, 0600); a da ponte vai para ~/.oba-ponte (0600).&lt;/li&gt;&lt;li style="margin-bottom:5px;"&gt;Só o CloudFront é público: buckets com BPA e TLS obrigatório; Function URL com AWS_IAM (OAC).&lt;/li&gt;&lt;/ul&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c194"><mxGeometry x="10" y="28" width="542" height="262" as="geometry"/></mxCell>
        <mxCell id="c196" value="Tópicos MQTT (&amp;lt;p&amp;gt;/&amp;lt;dev&amp;gt;/…)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;strokeColor=#7AA116;fillColor=#FFFFFF;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#3F8624;" vertex="1" parent="1"><mxGeometry x="1540" y="1345" width="440" height="300" as="geometry"/></mxCell>
        <mxCell id="c197" value='&lt;table style="border-collapse:collapse;font-size:11px;"&gt;&lt;tr&gt;&lt;td style="padding:1px 10px 1px 0;font-family:monospace;white-space:nowrap;vertical-align:top;"&gt;state&lt;/td&gt;&lt;td style="padding:1px 0;"&gt;estado da placa (retido, LWT)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:1px 10px 1px 0;font-family:monospace;white-space:nowrap;vertical-align:top;"&gt;evt&lt;/td&gt;&lt;td style="padding:1px 0;"&gt;eventos da placa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:1px 10px 1px 0;font-family:monospace;white-space:nowrap;vertical-align:top;"&gt;transcript&lt;/td&gt;&lt;td style="padding:1px 0;"&gt;frases do Transcribe&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:1px 10px 1px 0;font-family:monospace;white-space:nowrap;vertical-align:top;"&gt;reply&lt;/td&gt;&lt;td style="padding:1px 0;"&gt;respostas aos comandos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:1px 10px 1px 0;font-family:monospace;white-space:nowrap;vertical-align:top;"&gt;cmd&lt;/td&gt;&lt;td style="padding:1px 0;"&gt;comandos para a placa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:1px 10px 1px 0;font-family:monospace;white-space:nowrap;vertical-align:top;"&gt;ext/&amp;lt;fonte&amp;gt;&lt;/td&gt;&lt;td style="padding:1px 0;"&gt;pedidos de uma fonte externa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:1px 10px 1px 0;font-family:monospace;white-space:nowrap;vertical-align:top;"&gt;ext/&amp;lt;fonte&amp;gt;/re&lt;/td&gt;&lt;td style="padding:1px 0;"&gt;decisão tocada na placa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:1px 10px 1px 0;font-family:monospace;white-space:nowrap;vertical-align:top;"&gt;ui/&amp;lt;canal&amp;gt;&lt;/td&gt;&lt;td style="padding:1px 0;"&gt;para o portal (a placa não assina); ui/oba e ui/summary retidos&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c196"><mxGeometry x="12" y="30" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="c198" value="Placa → state, evt, transcript, reply, ext/…/re&lt;br&gt;Nuvem: router → cmd, ui/*; portal-api → cmd; installer → cmd, ui/install&lt;br&gt;Ponte → ext/&amp;lt;fonte&amp;gt; (status, ask, ask.cancel, react; LWT status offline) · lê ext/&amp;lt;fonte&amp;gt;/re e state (retido)&lt;br&gt;Portal só assina e recebe (nunca ext)" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#545B64;spacing=2;" vertex="1" parent="c196"><mxGeometry x="12" y="188" width="420" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
