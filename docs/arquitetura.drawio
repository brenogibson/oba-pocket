        <mxCell id="c9" value="Navegador — portal do Oba" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.client;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1"><mxGeometry x="50" y="252" width="540" height="173" as="geometry"/></mxCell>
        <mxCell id="c10" value="Portal&lt;br&gt;(SPA estática)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.mobile_client;" vertex="1" parent="c9"><mxGeometry x="24" y="38" width="41" height="78" as="geometry"/></mxCell>
        <mxCell id="c11" value="auth.js — login OAuth2 (código + PKCE) no User Pool&lt;br&gt;live.js — credenciais do Identity Pool (1 h) e MQTT WSS: lê state, evt, transcript, reply, cmd e ui/oba · ui/think · ui/summary · ui/install (nunca ext)&lt;br&gt;/api/* (token x-oba-token): envia Obas em zip (validados), apaga do registro, ativa/remove/instala na placa, toca som; o REC só desliga" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#232F3E;spacing=2;" vertex="1" parent="c9"><mxGeometry x="92" y="32" width="440" height="120" as="geometry"/></mxCell>
        <mxCell id="c12" value="Máquina do desenvolvedor — Claude Code + ponte (plugin oba-ponte)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.client;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1"><mxGeometry x="50" y="440" width="540" height="310" as="geometry"/></mxCell>
        <mxCell id="c13" value="PermissionRequest é síncrono: o hook espera a decisão tocada na placa (até 300 s).&lt;br&gt;resumo.py resume cada evento (≤ 1500 B), redige segredos e marca comandos perigosos." style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#545B64;spacing=2;" vertex="1" parent="c12"><mxGeometry x="14" y="28" width="522" height="44" as="geometry"/></mxCell>
