        <mxCell id="c69" value="&amp;lt;região-tr&amp;gt; (Transcribe · ex.: sa-east-1; padrão: a região principal)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="c46"><mxGeometry x="20" y="955" width="325" height="275" as="geometry"/></mxCell>
        <mxCell id="c70" value="Amazon Transcribe&lt;br&gt;Streaming · pt-BR&lt;br&gt;vocabulário &amp;lt;p&amp;gt;-ptbr" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transcribe;" vertex="1" parent="c69"><mxGeometry x="125" y="105" width="64" height="64" as="geometry"/></mxCell>
        <mxCell id="c71" value="IAM (global) — funções com menor privilégio" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.identity_and_access_management;strokeColor=#DD344C;fillColor=none;verticalAlign=top;align=left;spacingLeft=96;fontColor=#C7131F;dashed=1;" vertex="1" parent="c46"><mxGeometry x="365" y="955" width="665" height="275" as="geometry"/></mxCell>
        <mxCell id="c72" value="&amp;lt;p&amp;gt;-transcribe: só transcribe:StartStreamTranscriptionWebSocket em &amp;lt;região-tr&amp;gt;&lt;br&gt;(assumida pelo provedor de credenciais; credenciais de 1 h)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="c71"><mxGeometry x="31" y="45" width="78" height="44" as="geometry"/></mxCell>
        <mxCell id="c73" value="&amp;lt;p&amp;gt;-portal-viewer: função do Identity Pool; iot:Connect/Subscribe/Receive&lt;br&gt;só em &amp;lt;p&amp;gt;/&amp;lt;dev&amp;gt;/… (sem ext); a mesma política também vai no IoT,&lt;br&gt;anexada ao identity ID pela portal-api (as duas precisam liberar)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="c71"><mxGeometry x="31" y="115" width="78" height="44" as="geometry"/></mxCell>
        <mxCell id="c74" value="Funções das Lambdas e do AgentCore (&amp;lt;p&amp;gt;-agent): cada uma só nos recursos que usa&lt;br&gt;(tabela, bucket, modelos da lista, logs); a regra invoca a Lambda por permissão de&lt;br&gt;recurso (sem função). portal-api: iot:AttachPolicy em * (o IAM não filtra o alvo&lt;br&gt;Cognito), com Deny em certificados e grupos; o código só anexa a política viewer" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="c71"><mxGeometry x="31" y="193" width="78" height="44" as="geometry"/></mxCell>
