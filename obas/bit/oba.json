    "sprites/happy.png": "361fa2b09f5f3d9622e59a3890df5e4b82e3646a1bb60f86a919973b95f94f6a",
    "sprites/idle.png": "1984ab90f011de5deccf9d23c2abc244ce4c2f867db7654ce199999683272ba6",
